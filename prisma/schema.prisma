// LocalPost — Social Media Scheduler SaaS
// Targeting Pakistan / South Asia SMBs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatar       String?
  businessName String?
  timezone     String   @default("Asia/Karachi")
  plan         String   @default("free") // free | pro | agency
  role         String   @default("owner") // owner | admin | editor | viewer
  prefs        String   @default("{}") // JSON: emailWeeklyReport, emailFailed, emailPublished, pushNotifs, aiSuggestions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  posts         Post[]
  notifications Notification[]
  contentItems  ContentItem[]
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  platform    String   // instagram | facebook | twitter | linkedin | tiktok
  handle      String
  displayName String
  avatar      String?
  followers   Int      @default(0)
  connected   Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       Post[]
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  accountId   String?
  caption     String
  mediaUrls   String   @default("[]") // JSON array of URLs (sqlite limitation)
  mediaType   String   @default("image") // image | video | carousel | text
  hashtags    String   @default("[]") // JSON array
  status      String   @default("draft") // draft | scheduled | publishing | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  metrics PostMetric?
}

model PostMetric {
  id          String @id @default(cuid())
  postId      String @unique
  likes       Int    @default(0)
  comments    Int    @default(0)
  shares      Int    @default(0)
  reach       Int    @default(0)
  impressions Int    @default(0)
  saves       Int    @default(0)
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // post_published | post_failed | reminder | system | welcome
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  type      String   // image | video | template | caption
  title     String
  url       String?
  content   String?
  tags      String?  // comma separated
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        String   @id @default(cuid())
  ownerId   String   // the workspace owner (User.id)
  email     String
  name      String
  role      String   @default("editor") // admin | editor | viewer
  status    String   @default("invited") // invited | active | removed
  avatarColor String @default("#fca311")
  createdAt DateTime @default(now())
}

model Competitor {
  id        String   @id @default(cuid())
  userId    String
  handle    String
  platform  String   // instagram | facebook | twitter
  displayName String
  followers Int      @default(0)
  avgEngagement Float @default(0) // average engagement rate %
  postFrequency String @default("daily") // daily | weekly | irregular
  notes     String?
  color     String   @default("#fca311")
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String   // ticket creator
  userEmail String
  userName  String
  subject   String
  category  String   // billing | technical | feature_request | account | other
  priority  String   @default("normal") // low | normal | high | urgent
  message   String
  status    String   @default("open") // open | in_progress | resolved | closed
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
